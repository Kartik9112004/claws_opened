# ── NVIDIA NIM Configuration (Primary LLM Provider) ──────────────────────────
# Optional. If provided, the agent will use NVIDIA NIM.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_DEFAULT_MODEL=meta/llama-3.3-70b-instruct

# ── OpenRouter Configuration (Fallback LLM & Embeddings Provider) ──────────
# Required for RAG embeddings, and acts as fallback LLM if NVIDIA_API_KEY is blank.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-120b

# ── Telegram Bot Configuration (Required for Telegram mode) ─────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id_here

# ── Supabase Configuration (Required for RAG / Semantic Search) ──────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Firecrawl Configuration (Optional, for web search / scraping tools) ──────
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ── Additional Settings (Optional) ──────────────────────────────────────────
# Semicolon-separated list of directories containing custom agent skills.
SKILLS_DIRS=

# Workspace root path. Defaults to the repository root if left commented out/unset.
# Set this to a specific folder path (e.g. /Users/username/Desktop) only if you
# want the agent to operate on a different workspace outside the repository.
# CODEBASE_PATH=
